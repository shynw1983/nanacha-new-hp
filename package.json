{
  "name": "nanacha-kiyokawa-site",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js website for nanacha Fukuoka Kiyokawa.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "publish": "node scripts/publish.js",
    "i18n": "node scripts/i18n.js",
    "i18n:extract": "node scripts/i18n.js extract",
    "i18n:translate": "node scripts/i18n.js translate:openai",
    "i18n:translate:openai": "node scripts/i18n.js translate:openai",
    "i18n:update": "node scripts/i18n.js extract && node scripts/i18n.js translate:openai",
    "i18n:update:en": "node scripts/i18n.js extract && OPENAI_TRANSLATION_LANGUAGES=en node scripts/i18n.js translate:openai",
    "lark:export-menu": "node scripts/export-lark-menu.js",
    "lark:publish": "node scripts/publish-lark-content.js",
    "lark:sync-homepage-settings": "node scripts/sync-homepage-settings.js",
    "lark:sync-images": "node scripts/sync-lark-images.js",
    "lark:sync-store-products": "node scripts/sync-store-products.js"
  },
  "keywords": ["nanacha", "nextjs", "vercel"],
  "license": "UNLICENSED",
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
